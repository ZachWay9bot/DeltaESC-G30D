+static void observer_seed_phase(sensorless_control_t *s, uint16_t phase) {
+    int32_t cs = cos_q15(phase), sn = sin_q15(phase);
+    int64_t lambda = (int64_t)s->flux_target_raw;
+    s->x_alpha = (lambda * cs) >> 15;
+    s->x_beta  = (lambda * sn) >> 15;
+    s->e_alpha = (int32_t)s->x_alpha;
+    s->e_beta  = (int32_t)s->x_beta;
+    s->observer_phase = (uint16_t)(phase + s->phase_offset_u16);
+    s->observer_phase_prev = s->observer_phase;
+    s->observer_speed = 0;
+    s->flux_sq = (uint32_t)(lambda * lambda);
+    s->observer_valid = 1u;
+    s->i_alpha_prev = 0;
+    s->i_beta_prev = 0;
+}
+
