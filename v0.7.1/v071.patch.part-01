+static uint16_t dash_current_request_ma(uint8_t throttle){
+    if(throttle<=DASH_THROTTLE_DEADZONE)return 0u;
+    uint32_t span=(uint32_t)(255u-DASH_THROTTLE_DEADZONE);
+    uint32_t x=(uint32_t)(throttle-DASH_THROTTLE_DEADZONE);
+    uint32_t ma=DASH_DRIVE_MIN_MA+(x*(DASH_DRIVE_MAX_MA-DASH_DRIVE_MIN_MA))/span;
+    if(ma>DASH_DRIVE_MAX_MA)ma=DASH_DRIVE_MAX_MA;
+    return (uint16_t)ma;
+}
+static void dashboard_motor_off(uint8_t neutral_confirmed){
+    g_dash_drive_requested=0u;
+    power_stage_force_disarm();
+    if(neutral_confirmed)g_start_interlock=0u;
+    else g_start_interlock=1u;
+}
 static uint8_t handle_stock_dashboard(const ninebot_frame_t *f){
     uint8_t throttle=0u,brake=0u;
     if(dashboard_decode_adc(f,&throttle,&brake)){
-        g_dash_throttle=throttle;g_dash_brake=brake;
+        g_dash_throttle=throttle;g_dash_brake=brake;g_dash_control_last_ms=g_ms;g_dash_control_frames++;
+        if(brake>DASH_BRAKE_DEADZONE){dashboard_motor_off(0u);return 1u;}
+        if(throttle<=DASH_THROTTLE_DEADZONE){dashboard_motor_off(1u);return 1u;}
+        if(g_start_interlock||g_safety_latched||g_offset_cal_active)return 1u;
+#if POWER_STAGE_ARM_ALLOWED && SENSORLESS_RUN_ALLOWED
+        uint16_t ma=dash_current_request_ma(throttle);
+        if(!sensorless_control_set_run_current_ma(&ctrl,ma)){dashboard_motor_off(0u);return 1u;}
+        g_cfg_test_current_ma=ma;
+        if(!g_power_armed){if(!power_stage_arm_zero_vector())return 1u;}
+        if(!ctrl.drive_request)sensorless_control_set_drive(&ctrl,1u);
+        g_dash_drive_requested=1u;
+#endif
         return 1u;
     }
     if(dashboard_is_status_request(f)){
@@ -460,10 +508,11 @@
 
