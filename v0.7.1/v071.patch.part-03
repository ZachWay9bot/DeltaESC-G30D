+uint8_t sensorless_control_set_motor_params(sensorless_control_t *s,
+                                            uint32_t resistance_uohm,
+                                            uint32_t inductance_nh,
+                                            uint32_t flux_uwb) {
+    if (resistance_uohm < 20000u || resistance_uohm > 500000u) return 0u;
+    if (inductance_nh < 20000u || inductance_nh > 500000u) return 0u;
+    if (flux_uwb < 2000u || flux_uwb > 50000u) return 0u;
+
+    /* At the provisional G30 scales and 4 kHz control rate:
+       0.100 ohm -> Rq8 ~= 92, 100 uH -> Lq8 ~= 368,
+       0.012 Wb -> flux radius ~= 3429. */
+    uint32_t rq8 = (resistance_uohm * 92u + 50000u) / 100000u;
+    uint32_t lq8 = (inductance_nh * 368u + 50000u) / 100000u;
+    uint32_t fr  = (flux_uwb * 3429u + 6000u) / 12000u;
+    if (rq8 < 1u || rq8 > 4095u || lq8 < 1u || lq8 > 8191u || fr < 128u || fr > 20000u) return 0u;
+
+    s->motor_r_uohm = resistance_uohm;
+    s->motor_l_nh = inductance_nh;
+    s->flux_uwb = flux_uwb;
+    s->observer_r_q8 = (uint16_t)rq8;
+    s->observer_l_q8 = (uint16_t)lq8;
+    s->flux_target_raw = fr;
+    observer_reset(s);
+    return 1u;
+}
