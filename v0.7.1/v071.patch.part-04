+        int16_t d=phase_delta(s->observer_phase,s->openloop_phase);
+        uint32_t blend=s->state_ticks;if(blend>HANDOVER_TICKS)blend=HANDOVER_TICKS;
+        s->control_phase=(uint16_t)(s->openloop_phase+((int32_t)d*(int32_t)blend)/(int32_t)HANDOVER_TICKS);
+        int32_t se=abs32(s->observer_speed-(int32_t)s->openloop_step);
+        if(!s->observer_valid || se>(SPEED_LOCK_LIMIT_STEP*2)){if(s->lost_ticks<0xFFFFu)s->lost_ticks++;}else s->lost_ticks=0u;
+        if(s->lost_ticks>=OBS_LOST_TICKS){s->fault=2u;s->state=SENSORLESS_FAULT;}
+        else if(s->state_ticks>=HANDOVER_TICKS){s->state=SENSORLESS_CLOSED_LOOP;s->state_ticks=0u;s->lost_ticks=0u;}
         break;
     }
+
     case SENSORLESS_CLOSED_LOOP:
-        s->control_phase = s->observer_phase;
-        if (!s->observer_valid) { if (s->lost_ticks < 0xFFFFu) s->lost_ticks++; } else s->lost_ticks = 0;
-        if (s->lost_ticks >= OBS_LOST_TICKS) { s->fault = 3; s->state = SENSORLESS_FAULT; }
+        s->control_phase=s->observer_phase;
+        if(!s->observer_valid || s->observer_speed<8){if(s->lost_ticks<0xFFFFu)s->lost_ticks++;}else s->lost_ticks=0u;
+        if(s->lost_ticks>=OBS_LOST_TICKS){s->fault=3u;s->state=SENSORLESS_FAULT;}
         break;
+
     case SENSORLESS_FAULT:
     default:
-        s->drive_request = 0; zero_vector(s, pwm_arr); return;
+        s->drive_request=0u;zero_vector(s,pwm_arr);return;
     }
-    int32_t iq_ref = (s->state == SENSORLESS_ALIGN) ? ALIGN_IQ_COUNTS : s->run_iq_counts;
-    current_control(s, i_alpha, i_beta, s->control_phase, iq_ref, pwm_arr);
+
+    int32_t id_ref=0,iq_ref=0;
+    if(s->state==SENSORLESS_ALIGN) id_ref=ALIGN_ID_COUNTS;
+    else iq_ref=s->run_iq_counts;
+    current_control(s,i_alpha,i_beta,s->control_phase,id_ref,iq_ref,pwm_arr);
 }
 
 const char *sensorless_state_name(uint8_t state) {
     switch ((sensorless_state_id_t)state) {
-    case SENSORLESS_STOP: return "STOP"; case SENSORLESS_ALIGN: return "ALIGN"; case SENSORLESS_OPEN_LOOP: return "OPEN";
-    case SENSORLESS_HANDOVER: return "HANDOVER"; case SENSORLESS_CLOSED_LOOP: return "CLOSED"; case SENSORLESS_FAULT: return "FAULT";
+    case SENSORLESS_STOP: return "STOP";
+    case SENSORLESS_ALIGN: return "ALIGN";
+    case SENSORLESS_OPEN_LOOP: return "OPEN";
+    case SENSORLESS_HANDOVER: return "HANDOVER";
+    case SENSORLESS_CLOSED_LOOP: return "CLOSED";
+    case SENSORLESS_FAULT: return "FAULT";
     default: return "?";
     }
 }
