--- a/src/motor_id.c
+++ b/src/motor_id.c
@@ -0,0 +1,156 @@
+#include "motor_id.h"
+#include <stddef.h>
+
+#define ID_MIN_SAMPLES 8u
+#define ID_MAX_STAGE_US 3000000u
+#define ID_MAX_DT_US 100000u
+/* Absolute bounds mirror the existing sensorless parameter ABI. */
+#define ID_R_MIN 1000u
+#define ID_R_MAX 2000000u
+#define ID_L_MIN 1000u
+#define ID_L_MAX 5000000u
+#define ID_FLUX_MIN 100u
+#define ID_FLUX_MAX 1000000u
+
+/* No libgcc/compiler-rt assumed on the bare-metal F103. Clang otherwise
+ * emits __aeabi_uldivmod for uint64_t/uint32_t and a host-only suite
+ * can falsely claim the embedded firmware links. We bound overflow and use
+ * a 32-step long division with 64-bit remainder to keep it generic. */
+static uint32_t divide_u64_u32(uint64_t numerator, uint32_t denominator) {
+    if (!denominator || (numerator >> 32) >= denominator) return 0xffffffffu;
+    uint32_t quotient=0u;
+    uint32_t remainder=(uint32_t)(numerator>>32);
+    for(int bit=31;bit>=0;--bit) {
+        uint64_t shifted=((uint64_t)remainder<<1)|(((uint32_t)numerator>>(unsigned)bit)&1u);
+        if(shifted >= denominator) {
+            shifted-=denominator;
+            quotient|=1u<<(unsigned)bit;
+        }
+        remainder=(uint32_t)shifted;
+    }
+    return quotient;
+}
+
+static uint8_t fail(motor_id_t *m, uint8_t why) {
+    m->fault=(uint8_t)(m->fault|why);
+    m->state=MOTOR_ID_FAULT;
+    m->result.valid=0u;
+    m->result.r_uohm=0u;
+    m->result.l_nh=0u;
+    m->result.flux_uwb=0u;
+    return 0u;
+}
+static uint32_t abs_i32(int32_t v) {return v<0?(uint32_t)(-(int64_t)v):(uint32_t)v;}
+static void reset_accumulator(motor_id_t *m) {
+    m->sum=0u; m->samples=0u; m->elapsed_stage_us=0u;
+    m->min_value=0xffffffffu; m->max_value=0u;
+}
+void motor_id_init(motor_id_t *m) {
+    if (!m) return;
+    volatile uint8_t *p=(volatile uint8_t *)m;
+    for(uint32_t i=0u;i<(uint32_t)sizeof(*m);i++)p[i]=0u;
+    m->state=MOTOR_ID_IDLE;
+}
+void motor_id_abort(motor_id_t *m) {
+    if(!m) return;
+    (void)fail(m,MOTOR_ID_ABORT);
+}
+uint8_t motor_id_begin(motor_id_t *m, const motor_id_qualification_t *q) {
+    if (!m) return 0u;
+    motor_id_init(m);
+    if (!q || !q->gate_shutdown_verified || !q->current_scale_verified ||
+        !q->sample_timing_verified || !q->bus_sense_verified ||
+        !q->overcurrent_protection_verified || !q->wheel_unloaded)
+        return fail(m,MOTOR_ID_BAD_QUALIFICATION);
+    m->state=MOTOR_ID_RESISTANCE;reset_accumulator(m);
+    return 1u;
+}
+static uint8_t complete_stage(motor_id_t *m) {
+    if(m->samples<ID_MIN_SAMPLES) return 1u;
+    /* Reject samples whose variation is > +/-20% of their mean. */
+    uint32_t avg=divide_u64_u32(m->sum,m->samples);
+    if (!avg || (uint64_t)(m->max_value-m->min_value)*5u > avg)
+        return fail(m,MOTOR_ID_INCONSISTENT);
+    switch(m->state) {
+    case MOTOR_ID_RESISTANCE:
+        m->result.r_uohm=avg; m->result.samples_r=m->samples;
+        m->state=MOTOR_ID_INDUCTANCE; break;
+    case MOTOR_ID_INDUCTANCE:
+        m->result.l_nh=avg; m->result.samples_l=m->samples;
+        m->state=MOTOR_ID_FLUX;break;
+    case MOTOR_ID_FLUX:
+        m->result.flux_uwb=avg; m->result.samples_flux=m->samples;
+        m->result.valid=1u;m->state=MOTOR_ID_READY;break;
+    default: return fail(m,MOTOR_ID_BAD_SAMPLE);
+    }
+    reset_accumulator(m);
+    return 1u;
+}
+uint8_t motor_id_accept(motor_id_t *m, const motor_id_sample_t *s) {
+    if(!m || m->state==MOTOR_ID_FAULT || m->state==MOTOR_ID_IDLE || m->state==MOTOR_ID_READY)
+        return 0u;
+    if(!s || s->fault_active || s->brake_active || s->stop_requested || !s->samples_synchronized)
+        return fail(m,MOTOR_ID_BAD_SAMPLE);
+    if(m->seen_seq && s->sequence!=m->last_seq+1u)
+        return fail(m,MOTOR_ID_SEQUENCE);
+    if(s->stage!=m->state || !s->elapsed_us || s->elapsed_us>ID_MAX_DT_US)
+        return fail(m,MOTOR_ID_BAD_SAMPLE);
+    if(m->elapsed_stage_us>ID_MAX_STAGE_US-s->elapsed_us)
+        return fail(m,MOTOR_ID_TIMEOUT);
+    m->elapsed_stage_us+=s->elapsed_us;
+    m->last_seq=s->sequence;m->seen_seq=1u;
+    uint32_t value=0u;
+    uint64_t numerator=0u;
+    uint32_t denominator=0u;
+    if(m->state==MOTOR_ID_RESISTANCE) {
+        /* Locked motor, steady current: R = V/I. Reject zero/reversed current,
+         * excessive test current and a still-turning rotor. */
+        if(s->electrical_speed_mrad_s!=0u ||
+           abs_i32(s->current_ma)<200u || abs_i32(s->current_ma)>2000u ||
+           s->current_ma<0 || s->voltage_mv<=0 || s->voltage_mv>3000)
+            return fail(m,MOTOR_ID_RANGE);
+        numerator=(uint64_t)(uint32_t)s->voltage_mv*1000000u;
+        denominator=(uint32_t)s->current_ma;
+    } else if(m->state==MOTOR_ID_INDUCTANCE) {
+        /* One current derivative interval, with previously determined R.
+         * L = (V - I*R) * dt / di. Values use mV,mA,us,nH. */
+        if(s->electrical_speed_mrad_s!=0u ||
+           s->current_ma<0 || s->current_ma>2000 ||
+           s->previous_current_ma<0 || s->previous_current_ma>2000 ||
+           s->current_ma<=s->previous_current_ma ||
+           s->voltage_mv<=0 || s->voltage_mv>3000)
+            return fail(m,MOTOR_ID_RANGE);
+        uint32_t di=(uint32_t)(s->current_ma-s->previous_current_ma);
+        uint32_t resistive_mv=divide_u64_u32((uint64_t)(uint32_t)s->current_ma*m->result.r_uohm,1000000u);
+        int64_t inductive_mv=(int64_t)s->voltage_mv-resistive_mv;
+        if(inductive_mv<1 || di<1) return fail(m,MOTOR_ID_RANGE);
+        numerator=(uint64_t)inductive_mv*s->elapsed_us*1000u;
+        denominator=di;
+    } else {
+        /* E = omega_e * lambda, electrical speed in mrad/s.
+         * Magnitudes only: direction/sign separately qualified. */
+        if(s->electrical_speed_mrad_s<1000u || s->electrical_speed_mrad_s>200000u ||
+           s->bemf_mv<10u || s->bemf_mv>60000u ||
+           abs_i32(s->current_ma)>100u)
+            return fail(m,MOTOR_ID_RANGE);
+        numerator=(uint64_t)s->bemf_mv*1000000u;
+        denominator=s->electrical_speed_mrad_s;
+    }
+    if(!denominator) return fail(m,MOTOR_ID_RANGE);
+    value=divide_u64_u32(numerator,denominator);
+    if(value==0xffffffffu) return fail(m,MOTOR_ID_RANGE);
+    uint32_t lo=m->state==MOTOR_ID_RESISTANCE?ID_R_MIN:(m->state==MOTOR_ID_INDUCTANCE?ID_L_MIN:ID_FLUX_MIN);
+    uint32_t hi=m->state==MOTOR_ID_RESISTANCE?ID_R_MAX:(m->state==MOTOR_ID_INDUCTANCE?ID_L_MAX:ID_FLUX_MAX);
+    if(value<lo || value>hi) return fail(m,MOTOR_ID_RANGE);
+    m->sum+=value;
+    if(value<m->min_value)m->min_value=value;
+    if(value>m->max_value)m->max_value=value;
+    m->samples++;
+    return complete_stage(m);
+}
+uint8_t motor_id_commit(const motor_id_t *m, sensorless_control_t *c) {
+    if(!m || !c || m->state!=MOTOR_ID_READY || m->fault || !m->result.valid ||
+       c->drive_request || c->state!=SENSORLESS_STOP || c->fault) return 0u;
+    return sensorless_control_set_motor_params(c,m->result.r_uohm,
+                                               m->result.l_nh,m->result.flux_uwb);
+}
--- a/src/motor_id.h
+++ b/src/motor_id.h
@@ -0,0 +1,81 @@
+#pragma once
+#include <stdint.h>
+#include "sensorless_control.h"
+
+/* v0.9.3: Hardware-neutral motor parameter identification from externally
+ * calibrated measurement tuples. Does NOT command PWM, energize phases, or
+ * infer electrical gain/polarity. Admission requires independent evidence.
+ * Quantities are millivolt, milliampere, microseconds, mrad/s, microohm,
+ * nanohenry and micro-weber, all 32-bit integer at the external interface.
+ */
+typedef enum {
+    MOTOR_ID_IDLE=0, MOTOR_ID_RESISTANCE=1, MOTOR_ID_INDUCTANCE=2,
+    MOTOR_ID_FLUX=3, MOTOR_ID_READY=4, MOTOR_ID_FAULT=5
+} motor_id_stage_t;
+
+enum {
+    MOTOR_ID_BAD_QUALIFICATION=1u<<0,
+    MOTOR_ID_BAD_SAMPLE=1u<<1,
+    MOTOR_ID_TIMEOUT=1u<<2,
+    MOTOR_ID_INCONSISTENT=1u<<3,
+    MOTOR_ID_RANGE=1u<<4,
+    MOTOR_ID_SEQUENCE=1u<<5,
+    MOTOR_ID_ABORT=1u<<6
+};
+
+typedef struct {
+    uint8_t gate_shutdown_verified;      /* independent physical kill path */
+    uint8_t current_scale_verified;      /* ADC raw -> signed mA */
+    uint8_t sample_timing_verified;      /* ADC and PWM event alignment */
+    uint8_t bus_sense_verified;          /* actual applied phase voltage */
+    uint8_t overcurrent_protection_verified;
+    uint8_t wheel_unloaded;
+} motor_id_qualification_t;
+
+typedef struct {
+    uint32_t sequence;            /* strictly contiguous, wraps */
+    uint32_t elapsed_us;          /* elapsed since previous tuple */
+    uint8_t stage;                /* must match requested stage */
+    uint8_t brake_active;
+    uint8_t stop_requested;
+    uint8_t fault_active;
+    uint8_t samples_synchronized;
+    int32_t voltage_mv;          /* actual phase voltage (signed) */
+    int32_t current_ma;          /* actual phase current (signed) */
+    int32_t previous_current_ma; /* sampled at the previous timestamp */
+    uint32_t bemf_mv;            /* calibrated phase back-EMF */
+    uint32_t electrical_speed_mrad_s; /* not mechanical speed */
+} motor_id_sample_t;
+
+typedef struct {
+    uint32_t r_uohm;
+    uint32_t l_nh;
+    uint32_t flux_uwb;
+    uint32_t samples_r;
+    uint32_t samples_l;
+    uint32_t samples_flux;
+    uint8_t valid;
+} motor_id_result_t;
+
+typedef struct {
+    motor_id_result_t result;
+    uint64_t sum;
+    uint32_t samples;
+    uint32_t last_seq;
+    uint32_t elapsed_stage_us;
+    uint32_t min_value;
+    uint32_t max_value;
+    uint8_t seen_seq;
+    uint8_t state;
+    uint8_t fault;
+} motor_id_t;
+
+void motor_id_init(motor_id_t *m);
+/* No actuation. Returns false if the safety qualifications are absent. */
+uint8_t motor_id_begin(motor_id_t *m, const motor_id_qualification_t *q);
+/* Returns 1 for accepted tuple, 0 on fault/refusal. */
+uint8_t motor_id_accept(motor_id_t *m, const motor_id_sample_t *s);
+/* Returns true ONLY on completion of all three stages. */
+uint8_t motor_id_commit(const motor_id_t *m, sensorless_control_t *c);
+/* Abort always zeroes parameter validity; an explicit new begin is required. */
+void motor_id_abort(motor_id_t *m);
--- a/tools/motor_id_host_test.c
+++ b/tools/motor_id_host_test.c
@@ -0,0 +1,57 @@
+#include "motor_id.h"
+#include <stdio.h>
+#include <string.h>
+#define T(x) do {if(!(x)){printf("FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+static const motor_id_qualification_t qualified={1,1,1,1,1,1};
+static motor_id_sample_t make(uint32_t seq,uint8_t stage){
+    motor_id_sample_t s={0};s.sequence=seq;s.stage=stage;s.elapsed_us=1000;s.samples_synchronized=1;
+    if(stage==MOTOR_ID_RESISTANCE){s.voltage_mv=500;s.current_ma=1000;}
+    if(stage==MOTOR_ID_INDUCTANCE){s.voltage_mv=1000;s.current_ma=1000;s.previous_current_ma=900;}
+    if(stage==MOTOR_ID_FLUX){s.bemf_mv=200;s.electrical_speed_mrad_s=10000;}
+    return s;
+}
+static int nominal(void){
+    motor_id_t m;sensorless_control_t c={0};sensorless_control_init(&c);
+    T(motor_id_begin(&m,&qualified));
+    for(uint32_t i=0;i<24u;i++){
+        uint8_t stage=i<8?MOTOR_ID_RESISTANCE:(i<16?MOTOR_ID_INDUCTANCE:MOTOR_ID_FLUX);
+        motor_id_sample_t s=make(i+1u,stage);T(motor_id_accept(&m,&s));
+    }
+    T(m.result.valid && m.state==MOTOR_ID_READY && !m.fault);
+    T(m.result.r_uohm==500000u && m.result.l_nh==5000000u && m.result.flux_uwb==20000u);
+    T(m.result.samples_r==8 && m.result.samples_l==8 && m.result.samples_flux==8);
+    T(motor_id_commit(&m,&c) && c.motor_params_valid);
+    sensorless_control_set_drive(&c,1);
+    T(!motor_id_commit(&m,&c));
+    T(!motor_id_accept(&m,&(motor_id_sample_t){0}));
+    motor_id_abort(&m);T(!m.result.valid && m.state==MOTOR_ID_FAULT && !motor_id_commit(&m,&c));
+    return 0;
+}
+static int faults(void){
+    motor_id_t m;motor_id_sample_t s;
+    motor_id_qualification_t q=qualified;q.gate_shutdown_verified=0;
+    T(!motor_id_begin(&m,&q) && m.fault==MOTOR_ID_BAD_QUALIFICATION);
+    T(motor_id_begin(&m,&qualified));s=make(1,MOTOR_ID_RESISTANCE);
+    s.brake_active=1;T(!motor_id_accept(&m,&s) && m.state==MOTOR_ID_FAULT);
+    T(motor_id_begin(&m,&qualified));s=make(1,MOTOR_ID_RESISTANCE);
+    T(motor_id_accept(&m,&s));s.sequence=3;
+    T(!motor_id_accept(&m,&s) && m.fault==MOTOR_ID_SEQUENCE);
+    T(motor_id_begin(&m,&qualified));s=make(1,MOTOR_ID_RESISTANCE);s.current_ma=0;
+    T(!motor_id_accept(&m,&s) && m.fault==MOTOR_ID_RANGE);
+    T(motor_id_begin(&m,&qualified));s=make(1,MOTOR_ID_RESISTANCE);s.electrical_speed_mrad_s=1000;
+    T(!motor_id_accept(&m,&s) && m.fault==MOTOR_ID_RANGE);
+    T(motor_id_begin(&m,&qualified));s=make(1,MOTOR_ID_RESISTANCE);s.elapsed_us=0;
+    T(!motor_id_accept(&m,&s) && m.fault==MOTOR_ID_BAD_SAMPLE);
+    T(motor_id_begin(&m,&qualified));
+    for(unsigned i=0;i<7;i++){s=make(i+1,MOTOR_ID_RESISTANCE);T(motor_id_accept(&m,&s));}
