+grep -Fq 'ID_BENCH_RAW_TRIP_COUNTS' src/main.c
+grep -Fq 'motor_id_auto_tick(&g_motor_id_auto,t0/' src/main.c
+grep -Fq 'motor_id_flux_feedback_observe(' src/main.c
+! grep -Eq '\-DPOWER_STAGE_ARM_ALLOWED=1.*-DMOTOR_ID_BENCH_ALLOWED=1' Makefile
