 = 0u; j < STOCK_SERIAL_LEN; ++j) out[j] = region[i + j];
+        return 1u;
+    }
+    return 0u;
+}
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v066_base/src/stock_identity.h v066_serial/src/stock_identity.h
--- v066_base/src/stock_identity.h	1970-01-01 00:00:00.000000000 +0000
+++ v066_serial/src/stock_identity.h	2026-10-08 15:30:56.611300438 +0000
@@ -0,0 +1,11 @@
+#pragma once
+#include <stdint.h>
+
+#define STOCK_SERIAL_LEN 14u
+#define STOCK_IDENTITY_SCAN_BASE 0x0801F000u
+#define STOCK_IDENTITY_SCAN_BYTES 4096u
+
+/* Find the controller's own N4G... 14-byte serial inside preserved stock
+ * configuration pages. Pure buffer scanner so the policy can be host-tested. */
+uint8_t stock_identity_find_serial(const uint8_t *region, uint32_t length,
+                                   uint8_t out[STOCK_SERIAL_LEN]);
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v066_base/tools/preflight_v066.py v066_serial/tools/preflight_v066.py
