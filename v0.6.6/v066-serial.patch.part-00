diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v066_base/src/stock_identity.c v066_serial/src/stock_identity.c
--- v066_base/src/stock_identity.c	1970-01-01 00:00:00.000000000 +0000
+++ v066_serial/src/stock_identity.c	2026-10-08 15:30:56.610163110 +0000
@@ -0,0 +1,23 @@
+#include "stock_identity.h"
+
+static uint8_t serial_char_ok(uint8_t c) {
+    return (uint8_t)(((c >= (uint8_t)'0' && c <= (uint8_t)'9') ||
+                     (c >= (uint8_t)'A' && c <= (uint8_t)'Z')) ? 1u : 0u);
+}
+
+uint8_t stock_identity_find_serial(const uint8_t *region, uint32_t length,
+                                   uint8_t out[STOCK_SERIAL_LEN]) {
+    if (!region || !out || length < STOCK_SERIAL_LEN) return 0u;
+    for (uint32_t i = 0u; i <= length - STOCK_SERIAL_LEN; ++i) {
+        if (region[i] != (uint8_t)'N' || region[i + 1u] != (uint8_t)'4' ||
+            region[i + 2u] != (uint8_t)'G') continue;
+        uint8_t ok = 1u;
+        for (uint32_t j = 0u; j < STOCK_SERIAL_LEN; ++j) {
+            if (!serial_char_ok(region[i + j])) { ok = 0u; break; }
+        }
+        if (!ok) continue;
+        for (uint32_t j