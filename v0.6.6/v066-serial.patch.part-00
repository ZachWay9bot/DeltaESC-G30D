 CFLAGS_COMMON = --target=arm-none-eabi -mcpu=cortex-m3 -mthumb -ffreestanding -fno-builtin -fdata-sections -ffunction-sections -Oz -Wall -Wextra -Werror -Isrc
 LDFLAGS_COMMON = --target=arm-none-eabi -mcpu=cortex-m3 -mthumb -nostdlib -Wl,-T,linker.ld,--gc-sections
-SRC = src/main.c src/sensorless_control.c src/ninebot_link.c src/iap_update.c src/iap_proto.c src/dashboard_runtime.c
+SRC = src/main.c src/sensorless_control.c src/ninebot_link.c src/iap_update.c src/iap_proto.c src/dashboard_runtime.c src/stock_identity.c
 SAFE_ELF = build/DeltaESC_G30D_v0_6_6_ble_syncsafe.elf
 SAFE_BIN = build/DeltaESC_G30D_v0_6_6_ble_syncsafe.bin
 ACTIVE_ELF = build/DeltaESC_G30D_v0_6_6_ble_observer_zero_vector.elf
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v066_base/README.md v066_serial/README.md
--- v066_base/README.md	2026-10-08 15:28:19.000000000 +0000
+++ v066_serial/README.md	2026-10-08 15:31:42.919755694 +0000
@@ -14,6 +14,7 @@
 - Dashboard throttle/brake values are diagnostic only in this step. They do not request torque.
 - D0-D9 diagnostics and E0-E6/F0-F5 protocol remain present; build identity is \`0x0606\`.
 - App-originated reads no longer falsely count as dashboard-runtime traffic; the dashboard-seen flag now requires native source \`0x21\`.
+- Preserves the working G30 Bench BLE connection sequence by answering stock ESC register \`0x10\` with the controller's own 14-byte serial, scanned read-only from preserved stock configuration pages. If no valid \`N4G...\` serial is found, the diagnostic flags expose that condition rather than treating the fallback as verified.
 
 ## Safety boundary
 
