rdware image remains SYNC-SAFE: power-stage arming and sensorless run are compiled out. v0.6.6 is meant to validate the complete stock dashboard/BLE/ESC communication loop and later SHU reflash path before any torque-producing test.
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v065_src/src/dashboard_runtime.c v066_work/src/dashboard_runtime.c
--- v065_src/src/dashboard_runtime.c	1970-01-01 00:00:00.000000000 +0000
+++ v066_work/src/dashboard_runtime.c	2026-10-08 15:20:22.443579979 +0000
@@ -0,0 +1,32 @@
+#include "dashboard_runtime.h"
+
+static uint8_t native_dash_to_esc(const ninebot_frame_t *f) {
+    return (uint8_t)(f != 0 &&
+                     f->format == NINEBOT_FMT_5AA5 &&
+                     f->src == G30_DASH_ADDR &&
+                     f->dst == G30_ESC_ADDR);
+}
+
+uint8_t dashboard_decode_adc(const ninebot_frame_t *f, uint8_t *throttle, uint8_t *brake) {
+    if (!native_dash_to_esc(f) || f->cmd != G30_DASH_CMD_ADC ||
+        f->payload_len < 3u || throttle == 0 || brake == 0) {
+        return 0u;
+    }
+    *throttle = f->payload[1];
+    *brake = f->payload[2];
+    return 1u;
+}
+
+uint8_t dashboard_is_status_request(const ninebot_frame_t *f) {
+    return (uint8_t)(native_dash_to_esc(f) && f->cmd == G30_DASH_CMD_STATUS);
+}
+
+void dashboard_safe_status_payload(uint8_t out[G30_DASH_STATUS_BYTES]) {
+    if (!out) return;
+    out[0] = 0x01u; /* DRIVE icon */
+    out[1] = 50u;   /* explicit bench placeholder; vbus scaling still deferred */
+    out[2] = 0u;    /* light */
+    out[3] = 0u;    /* beep */
+    out[4] = 0u;    /* speed km/h */
+    out[5] = 0u;    /* dashboard-visible fault */
+}
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v065_src/src/dashboard_runtime.h v066_work/src/dashboard_runtime.h
--- v065_src/src/dashboard_runtime.h	1970-01-01 00:00:00.000000000 +0000
+++ v066_work/src/dashboard_runtime.h	2026-10-08 15:20:22.442862623 +0000
@@ -0,0 +1,20 @@
+#pragma once
+#include <stdint.h>
+#include "ninebot_link.h"
+
+#define G30_ESC_ADDR          0x20u
+#define G30_DASH_ADDR         0x21u
+#define G30_DASH_CMD_STATUS   0x64u
+#define G30_DASH_CMD_ADC      0x65u
+#define G30_DASH_STATUS_BYTES 6u
+
+/* Decode the stock dashboard ADC report. The G30 payload layout used by the
+ * proven VESC/dashboard bridge stores throttle/brake in payload[1]/[2]. */
+uint8_t dashboard_decode_adc(const ninebot_frame_t *f, uint8_t *throttle, uint8_t *brake);
+
+/* True for the native G30 0x64 request that expects an ESC status response. */
+uint8_t dashboard_is_status_request(const ninebot_frame_t *f);
+
+/* First-hardware-test status payload. Values are deliberately non-driving:
+ * Drive icon, neutral 50% placeholder battery, lights/beep/speed/fault zero. */
+void dashboard_safe_status_payload(uint8_t out[G30_DASH_STATUS_BYTES]);
