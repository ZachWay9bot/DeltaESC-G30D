diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v065_src/tools/preflight_v066.py v066_work/tools/preflight_v066.py
--- v065_src/tools/preflight_v066.py	1970-01-01 00:00:00.000000000 +0000
+++ v066_work/tools/preflight_v066.py	2026-10-08 15:20:23.125505512 +0000
@@ -0,0 +1,15 @@
+#!/usr/bin/env python3
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+main=(root/'src/main.c').read_text(); dash=(root/'src/dashboard_runtime.c').read_text(); iap=(root/'src/iap_update.c').read_text(); mk=(root/'Makefile').read_text()
+assert '#define FW_BUILD 0x0606u' in main
+assert 'dashboard_decode_adc' in main and 'dashboard_is_status_request' in main
+assert 'ninebot_send_app_response(f,G30_DASH_CMD_STATUS,0x00u,p,G30_DASH_STATUS_BYTES)' in main
+assert 'f->src==G30_DASH_ADDR&&f->dst==G30_ESC_ADDR' in main
+assert 'f->payload[1]' in dash and 'f->payload[2]' in dash
+assert 'out[0] = 0x01u' in dash and 'out[1] = 50u' in dash
+assert '0x08001002' not in iap
+assert 'src/dashboard_runtime.c' in mk
+for name in ['DeltaESC_G30D_v0_6_6_ble_syncsafe.bin','DeltaESC_G30D_v0_6_6_ble_observer_zero_vector.bin','DeltaESC_G30D_v0_6_6_ble_sensorless_bench.bin']:
+    b=(root/'build'/name).read_bytes(); assert len(b)<=0xD000,(name,len(b))
+print('v0.6.6 dashboard-runtime preflight: PASS')
diff -ruN '--exclude=build' '--exclude=shu' '--exclude=__pycache__' '--exclude=*.pyc' v065_src/tools/test_dashboard_runtime.py v066_work/tools/test_dashboard_runtime.py
--- v065_src/tools/test_dashboard_runtime.py	1970-01-01 00:00:00.000000000 +0000
+++ v066_work/tools/test_dashboard_runtime.py	2026-10-08 15:21:34.451478552 +0000
@@ -0,0 +1,12 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import os, subprocess
+root=Path(__file__).resolve().parents[1]
+out=root/'build'/'dashboard_runtime_host_test'
+out.parent.mkdir(exist_ok=True)
+cc=os.environ.get('HOST_CC','clang')
+subprocess.run([cc,'-std=c11','-Wall','-Wextra','-Werror','-Isrc',
+                'tools/dashboard_runtime_host_test.c','src/dashboard_runtime.c',
+                '-o',str(out)],cwd=root,check=True)
+subprocess.run([str(out)],check=True)
+print('G30 dashboard runtime host test: PASS')
