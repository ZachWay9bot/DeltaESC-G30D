diff --git a/src/motor_pipeline.c b/src/motor_pipeline.c
new file mode 100644
index 0000000..1796a60
--- /dev/null
+++ b/src/motor_pipeline.c
@@ -0,0 +1,134 @@
+#include "motor_pipeline.h"
+#include "stock_current_frontend.h"
+
+#define THROTTLE_IDLE_MAX 3u
+
+void motor_pipeline_init(motor_pipeline_t *p, sensorless_control_t *foc,
+                         motor_pipeline_io_t io, void *ctx, uint16_t arr,
+                         uint16_t limit) {
+    *p = (motor_pipeline_t){0};
+    foc_adc_contract_init(&p->adc);
+    p->foc = foc; p->io = io; p->io_ctx = ctx; p->arr = arr;
+    p->current_hard_limit_counts=limit;
+}
+
+void motor_pipeline_stop(motor_pipeline_t *p, uint8_t reason) {
+    if (!p) return;
+    /* Hardware off FIRST; 50% CCR is NOT motor OFF. */
+    if (p->io.gate_off) p->io.gate_off(p->io_ctx);
+    p->powered = 0u;
+    p->adc.pending = 0u;
+    p->adc_qualified = 0u;
+    p->last_stop_reason = reason;
+    if (reason==MOTOR_STOP_ADC || reason==MOTOR_STOP_FAULT ||
+        reason==MOTOR_STOP_PWM) p->fault_latched=1u;
+    if (p->foc) sensorless_control_stop(p->foc);
+}
+
+uint8_t motor_pipeline_start(motor_pipeline_t *p, const uint16_t offsets[3],
+                             uint8_t gate_ok, uint8_t adc_ok,
+                             uint8_t throttle, uint8_t brake,
+                             uint8_t dash_ok, uint32_t now_ms) {
+    if (!p || !p->foc) return 0u;
+    if (p->powered || !p->io.gate_off || !p->io.arm ||
+        !p->io.set_adc_pair || !p->io.set_pwm || !offsets ||
+        !gate_ok || !adc_ok || !dash_ok || brake || p->fault_latched ||
+        !p->current_hard_limit_counts ||
+        throttle <= THROTTLE_IDLE_MAX ||
+        p->foc->fault || p->foc->state == SENSORLESS_FAULT ||
+        !p->foc->motor_params_valid || !p->arr) {
+        motor_pipeline_stop(p, MOTOR_STOP_QUALIFICATION);
+        return 0u;
+    }
+    /* In particular, no old fault may be cleared merely by restarting. */
+    if (!foc_adc_contract_reset(&p->adc, 1u)) {
+        motor_pipeline_stop(p, MOTOR_STOP_FAULT); return 0u;
+    }
+    for (unsigned i=0u;i<3u;i++) p->offsets[i]=offsets[i];
+    p->last_sector=1u; p->next_sequence=1u; p->sample_divider=0u;
+    p->last_dashboard_ms=now_ms;
+    p->adc_qualified=1u;
+    if (!foc_adc_contract_prepare(&p->adc,p->last_sector,1u,p->offsets,1u) ||
+        !p->io.set_adc_pair(p->io_ctx,p->adc.expected_jsqr1,p->adc.expected_jsqr2) ||
+        !p->io.set_pwm(p->io_ctx,(uint16_t)((p->arr+1u)/2u),
+                       (uint16_t)((p->arr+1u)/2u),(uint16_t)((p->arr+1u)/2u))) {
+        motor_pipeline_stop(p, MOTOR_STOP_ADC); return 0u;
+    }
+    sensorless_control_set_drive(p->foc,1u);
+    if (!p->foc->drive_request || !p->io.arm(p->io_ctx)) {
+        motor_pipeline_stop(p, MOTOR_STOP_QUALIFICATION); return 0u;
+    }
+    p->powered=1u;
+    p->last_stop_reason=MOTOR_STOP_NONE;
+    return 1u;
+}
+
+void motor_pipeline_input(motor_pipeline_t *p, uint8_t throttle,
+                          uint8_t brake, uint8_t dashboard_valid,
+                          uint32_t now_ms) {
+    if (!p) return;
+    if (p->powered && (!dashboard_valid || brake || throttle<=THROTTLE_IDLE_MAX)) {
+        motor_pipeline_stop(p,!dashboard_valid?MOTOR_STOP_DASH:
+                           brake?MOTOR_STOP_BRAKE:MOTOR_STOP_THROTTLE);
+        return;
+    }
+    if (dashboard_valid) p->last_dashboard_ms=now_ms;
+}
+
+void motor_pipeline_watchdog(motor_pipeline_t *p, uint32_t now_ms,
+                             uint32_t dash_timeout_ms) {
+    if (p && p->powered &&
+        (uint32_t)(now_ms-p->last_dashboard_ms)>dash_timeout_ms)
+        motor_pipeline_stop(p,MOTOR_STOP_DASH);
+}
+
+uint8_t motor_pipeline_on_adc(motor_pipeline_t *p, foc_adc_sample_t *s,
+                              uint16_t vbus_adc) {
+    if (!p || !p->powered) return 0u;
+    if (!s || !p->adc_qualified || p->foc->fault ||
+        p->foc->state==SENSORLESS_FAULT ||
+        s->sequence!=p->next_sequence) {
+        motor_pipeline_stop(p,MOTOR_STOP_ADC); return 0u;
+    }
+    foc_adc_result_t current;
+    if (!foc_adc_contract_complete(&p->adc,s,&current)) {
+        motor_pipeline_stop(p,MOTOR_STOP_ADC); return 0u;
+    }
+    p->last_phase=current.counts;
+    /* Enforce the raw-count hard trip BEFORE FOC and TIM1 CCR writes.
+     * Not a calibrated ampere limit and not a substitute for hardware BKIN. */
+    int32_t a=current.counts.ia,b=current.counts.ib,c=current.counts.ic;
+    if(a<0)a=-a; if(b<0)b=-b; if(c<0)c=-c;
+    if(a>p->current_hard_limit_counts || b>p->current_hard_limit_counts ||
+       c>p->current_hard_limit_counts) {
+        motor_pipeline_stop(p,MOTOR_STOP_FAULT); return 0u;
+    }
+    if (++p->sample_divider>=4u) {
+        p->sample_divider=0u;
+        const phase_current_counts_t phase={current.counts.ia,current.counts.ib,current.counts.ic};
+        sensorless_control_step(p->foc,phase,vbus_adc,p->arr,1u);
+        if (p->foc->fault || !p->foc->drive_request ||
+            p->foc->state==SENSORLESS_FAULT ||
+            p->foc->state==SENSORLESS_STOP) {
+            motor_pipeline_stop(p,MOTOR_STOP_FAULT); return 0u;
+        }
+        if (!p->powered) return 0u; /* asynchronous brake/timeout won */
+        if (p->foc->ccr1>p->arr || p->foc->ccr2>p->arr || p->foc->ccr3>p->arr ||
+            !p->io.set_pwm(p->io_ctx,p->foc->ccr1,p->foc->ccr2,p->foc->ccr3)) {
+            motor_pipeline_stop(p,MOTOR_STOP_PWM); return 0u;
+        }
+    }
+    /* The sector used for the *next* sample belongs to the PWM vector
+     * already written, not the ADC sample we just consumed. */
+    if (!p->powered) return 0u; /* no new ADC plan after gate kill */
+    const uint8_t next_sector=stock_current_sector_from_ab(
+        p->foc->v_alpha_prev,p->foc->v_beta_prev);
+    ++p->next_sequence;
+    if (!foc_adc_contract_prepare(&p->adc,next_sector,p->next_sequence,p->offsets,1u) ||
+        !p->io.set_adc_pair(p->io_ctx,p->adc.expected_jsqr1,p->adc.expected_jsqr2)) {
+        motor_pipeline_stop(p,MOTOR_STOP_ADC); return 0u;
+    }
+    if (!p->powered) return 0u;
+    p->last_sector=next_sector;
+    return 1u;
+}
diff --git a/src/motor_pipeline.h b/src/motor_pipeline.h
new file mode 100644
index 0000000..512933e
--- /dev/null
+++ b/src/motor_pipeline.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <stdint.h>
+#include "foc_adc_contract.h"
+#include "sensorless_control.h"
+
+/* One owner for ADC -> reconstructed phase currents -> sensorless FOC/SVPWM
+ * -> TIM1 CCR preloads -> physically isolated gate channels.
+ * This interface models the entire path; hardware acceptance is an external
+ * mandatory qualification, not inferred from source-code compilation.
+ */
+typedef struct {
+    uint8_t (*arm)(void *ctx);
+    void (*gate_off)(void *ctx);
+    uint8_t (*set_adc_pair)(void *ctx, uint32_t jsqr1, uint32_t jsqr2);
+    uint8_t (*set_pwm)(void *ctx, uint16_t c1, uint16_t c2, uint16_t c3);
+} motor_pipeline_io_t;
+
+enum {
+    MOTOR_STOP_NONE=0u, MOTOR_STOP_THROTTLE=1u, MOTOR_STOP_BRAKE=2u,
+    MOTOR_STOP_DASH=3u, MOTOR_STOP_ADC=4u, MOTOR_STOP_FAULT=5u,
+    MOTOR_STOP_PWM=6u, MOTOR_STOP_QUALIFICATION=7u
+};
+typedef struct {
+    foc_adc_contract_t adc;
+    motor_pipeline_io_t io;
+    sensorless_control_t *foc;
+    void *io_ctx;
+    uint32_t next_sequence;
+    uint32_t last_dashboard_ms;
+    uint16_t arr;
+    uint16_t current_hard_limit_counts;
+    uint16_t offsets[3];
+    stock_phase_currents_t last_phase;
+    uint8_t powered;
+    uint8_t sample_divider;
+    uint8_t last_sector;
+    uint8_t last_stop_reason;
+    uint8_t adc_qualified;
+    uint8_t fault_latched;
+} motor_pipeline_t;
+
+void motor_pipeline_init(motor_pipeline_t *p, sensorless_control_t *foc,
+                         motor_pipeline_io_t io, void *io_ctx, uint16_t arr,
+                         uint16_t hard_current_limit_counts);
+/* Caller supplies independently-established power-stage and ADC-window
+ * qualification. No lab safety claim is made by this Boolean interface. */
+uint8_t motor_pipeline_start(motor_pipeline_t *p, const uint16_t offsets[3],
+                             uint8_t gate_qualified, uint8_t adc_qualified,
+                             uint8_t throttle, uint8_t brake,
+                             uint8_t dashboard_valid, uint32_t now_ms);
+/* gate_off is performed BEFORE any software neutral-vector calculation. */
+void motor_pipeline_stop(motor_pipeline_t *p, uint8_t reason);
+void motor_pipeline_input(motor_pipeline_t *p, uint8_t throttle,
+                          uint8_t brake, uint8_t dashboard_valid, uint32_t now_ms);
+void motor_pipeline_watchdog(motor_pipeline_t *p, uint32_t now_ms,
+                             uint32_t dash_timeout_ms);
+/* Must be called exactly once for each completed TIM1-triggered injected
+ * ADC1+ADC2 one-rank event; never from the two-rank diagnostic mode. */
+uint8_t motor_pipeline_on_adc(motor_pipeline_t *p, foc_adc_sample_t *sample,
+                              uint16_t vbus_adc);
diff --git a/tools/motor_pipeline_host_test.c b/tools/motor_pipeline_host_test.c
new file mode 100644
index 0000000..d341f0a
--- /dev/null
+++ b/tools/motor_pipeline_host_test.c
@@ -0,0 +1,76 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "motor_pipeline.h"
+#include "stock_current_frontend.h"
+
+typedef struct {
+    unsigned gate_on, gate_off, pwm_writes, adc_routes;
+    uint16_t c1,c2,c3;
+    uint32_t adc1_jsqr,adc2_jsqr;
+    unsigned reject_pwm,reject_adc,reject_arm;
+    unsigned event_seq;
+} fake_hw_t;
+static void ensure(unsigned v,const char *what){if(!v){fprintf(stderr,"FAILED %s\n",what);exit(1);}}
+static uint8_t arm(void *ctx){fake_hw_t *h=ctx;if(h->reject_arm)return 0;h->gate_on=1;return 1;}
+static void off(void *ctx){fake_hw_t *h=ctx;h->gate_on=0;h->gate_off++;}
+static uint8_t route(void *ctx,uint32_t a,uint32_t b){fake_hw_t *h=ctx;if(h->reject_adc)return 0;h->adc1_jsqr=a;h->adc2_jsqr=b;h->adc_routes++;return 1;}
+static uint8_t pwm(void *ctx,uint16_t a,uint16_t b,uint16_t c){fake_hw_t *h=ctx;if(h->reject_pwm)return 0;ensure(a<=1999&&b<=1999&&c<=1999,"PWM duty bounds");h->c1=a;h->c2=b;h->c3=c;h->pwm_writes++;return 1;}
+static foc_adc_sample_t sample(motor_pipeline_t *p, fake_hw_t *h){
+    (void)h;
+    const stock_adc_pair_t pair=stock_current_pair_for_sector(p->adc.expected_sector);
+    ensure(p->adc.expected_jsqr1==stock_current_jsqr_one(pair.adc1_channel),"ADC1 sector route");
+    ensure(p->adc.expected_jsqr2==stock_current_jsqr_one(pair.adc2_channel),"ADC2 sector route");
+    foc_adc_sample_t s={0};s.sequence=++h->event_seq;s.sector=p->adc.expected_sector;
+    s.adc1_jsqr=h->adc1_jsqr;s.adc2_jsqr=h->adc2_jsqr;
+    s.adc1_sr=4u;s.adc2_sr=4u;s.adc1_jdr1=2048;s.adc2_jdr1=2048;
+    s.dual_injected_simultaneous=1;s.sample_window_valid=1;return s;
+}
+static void ready(motor_pipeline_t *p,sensorless_control_t *c,fake_hw_t *h){
+    sensorless_control_init(c);
+    ensure(sensorless_control_set_motor_params(c,200000,300000,5000),"motor params");
+    motor_pipeline_io_t io={arm,off,route,pwm};
+    motor_pipeline_init(p,c,io,h,1999u,700u);
+}
+int main(void){
+    const uint16_t offsets[3]={2048,2048,2048};
+    for(unsigned kind=0;kind<10;kind++){
+        fake_hw_t hw={0};motor_pipeline_t p;sensorless_control_t c;ready(&p,&c,&hw);
+        ensure(!motor_pipeline_start(&p,offsets,0,1,80,0,1,0),"qualification denies gate");
+        ensure(!hw.gate_on,"unqualified never arms");
+        ensure(motor_pipeline_start(&p,offsets,1,1,80,0,1,1),"qualified mock start");
+        ensure(hw.gate_on && p.powered,"mock arm happened");
+        for(unsigned n=0;n<16;n++){
+            foc_adc_sample_t s=sample(&p,&hw);
+            ensure(motor_pipeline_on_adc(&p,&s,2700u),"full ADC reconstruction to FOC SVPWM to PWM");
+        }
+        ensure(hw.pwm_writes>=5,"FOC output wrote PWM");
+        ensure(hw.adc_routes>=17,"ADC channels rescheduled each sector");
+        if(kind==0){motor_pipeline_input(&p,0,0,1,5);ensure(p.last_stop_reason==MOTOR_STOP_THROTTLE,"throttle coast");}
+        if(kind==1){motor_pipeline_input(&p,80,1,1,5);ensure(p.last_stop_reason==MOTOR_STOP_BRAKE,"brake coast");}
+        if(kind==2){motor_pipeline_input(&p,80,0,0,5);ensure(p.last_stop_reason==MOTOR_STOP_DASH,"dashboard invalid coast");}
+        if(kind==3){motor_pipeline_watchdog(&p,260,250);ensure(p.last_stop_reason==MOTOR_STOP_DASH,"watchdog coast");}
+        if(kind==4){foc_adc_sample_t s=sample(&p,&hw);s.adc2_sr=0;ensure(!motor_pipeline_on_adc(&p,&s,2700),"ADC JEOC fault");ensure(p.last_stop_reason==MOTOR_STOP_ADC,"ADC coast");}
+        if(kind==5){foc_adc_sample_t s=sample(&p,&hw);s.sample_window_valid=0;ensure(!motor_pipeline_on_adc(&p,&s,2700),"ADC window fault");ensure(p.last_stop_reason==MOTOR_STOP_ADC,"window coast");}
+        if(kind==6){hw.reject_pwm=1;for(unsigned n=0;n<4;n++){foc_adc_sample_t s=sample(&p,&hw);(void)motor_pipeline_on_adc(&p,&s,2700);}ensure(p.last_stop_reason==MOTOR_STOP_PWM,"PWM write fault coast");}
+        if(kind==7){hw.reject_adc=1;foc_adc_sample_t s=sample(&p,&hw);ensure(!motor_pipeline_on_adc(&p,&s,2700),"ADC routing write refused");ensure(p.last_stop_reason==MOTOR_STOP_ADC,"ADC routing coast");}
+        if(kind==8){c.fault=3;foc_adc_sample_t s=sample(&p,&hw);ensure(!motor_pipeline_on_adc(&p,&s,2700),"observer fault refused");ensure(p.last_stop_reason==MOTOR_STOP_ADC,"observer coast");}
+        if(kind==9){
+            /* 2048+750 is below ADC rail but reconstructed current over
+             * 700 must be rejected *before* PWM for that FOC tick. */
+            unsigned oldpwm=hw.pwm_writes;
+            foc_adc_sample_t s=sample(&p,&hw);s.adc1_jdr1=2798;
+            ensure(!motor_pipeline_on_adc(&p,&s,2700),"overcurrent rejected");
+            ensure(hw.pwm_writes==oldpwm,"no PWM following current trip");
+            ensure(p.last_stop_reason==MOTOR_STOP_FAULT,"overcurrent coast");
+        }
+        ensure(!p.powered&&!hw.gate_on&&hw.gate_off>0,"gate physically off before returning");
+        ensure(c.state==SENSORLESS_STOP&&!c.drive_request,"FOC stopped");
+        if(kind>=4){
+            ensure(!motor_pipeline_start(&p,offsets,1,1,80,0,1,1),"fault remains latched");
+            ensure(!hw.gate_on,"latched fault never re-arms");
+        }
+    }
+    puts("PASS: ADC->sector reconstruction->sensorless FOC/SVPWM->TIM1 callback->gate with 10 stop/fault cases");
+    return 0;
+}
diff --git a/tools/run_v094_tests.sh b/tools/run_v094_tests.sh
new file mode 100644
index 0000000..9c4e2a0
--- /dev/null
+++ b/tools/run_v094_tests.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Software-only checks. No external hardware, no flashing, no motor enable.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+python3 tools/pinmap_power_regression_test.py
+make safe CC="${ARM_CC:-clang}" OBJCOPY="${ARM_OBJCOPY:-llvm-objcopy}" OBJDUMP="${ARM_OBJDUMP:-llvm-objdump}"
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+checks=(
+  'first_spin_safety_host_test.c sensorless_control.c'
+  'foc_adc_contract_host_test.c foc_adc_contract.c stock_current_frontend.c'
+  'foc_adc_motor_handoff_host_test.c foc_adc_motor_handoff.c sensorless_control.c'
+  'motor_id_host_test.c motor_id.c sensorless_control.c'
+  'sensorless_plant_host_test.c sensorless_control.c'
+  'motor_core_host_test.c sensorless_control.c'
+  'power_logic_host_test.c power_logic.c'
+  'iap_ack_host_test.c iap_proto.c'
+  'iap_transport_host_test.c iap_proto.c'
+  'stock_adc_timing_host_test.c stock_adc_timing.c'
+  'stock_adc_quality_host_test.c stock_adc_quality.c stock_current_frontend.c'
+  'stock_adc_snapshot_host_test.c stock_adc_snapshot.c stock_current_frontend.c'
+  'stock_dual_adc_runtime_host_test.c stock_dual_adc_runtime.c stock_dual_adc_plan.c stock_current_frontend.c'
+  'test_g30_fixed_scan.c g30_fixed_scan.c'
+  'test_stock_adc_mode_guard.c stock_adc_mode_guard.c stock_dual_adc_plan.c stock_current_frontend.c'
+  'test_ble_motor_probe.c motor_probe.c ble_motor_probe.c'
+)
+checks+=('motor_pipeline_host_test.c motor_pipeline.c foc_adc_contract.c stock_current_frontend.c sensorless_control.c')
+for check in "${checks[@]}"; do
+  read -ra files <<< "$check"
+  test="${files[0]}"; args=()
+  for f in "${files[@]:1}"; do args+=("src/$f"); done
+  extra_flags=()
+  if [ "$test" = sensorless_plant_host_test.c ] || [ "$test" = motor_pipeline_host_test.c ]; then
+      extra_flags+=(-DSENSORLESS_CLOSED_LOOP_ALLOWED=1)
+  fi
+  gcc -std=c11 -O1 -g -fsanitize=undefined -Isrc "${extra_flags[@]}" "tools/$test" "${args[@]}" -lm -o "$TMP/${test%.c}"
+  "$TMP/${test%.c}"
+  echo "PASS: $test"
+done
+for flags in '-DPOWER_STAGE_ARM_ALLOWED=1 -DSENSORLESS_RUN_ALLOWED=0' '-DPOWER_STAGE_ARM_ALLOWED=0 -DSENSORLESS_RUN_ALLOWED=1'; do
+  # shellcheck disable=SC2086
+  if "${ARM_CC:-clang}" --target=arm-none-eabi -mcpu=cortex-m3 -mthumb -Isrc $flags -c src/main.c -o "$TMP/bad.o" >"$TMP/reject.log" 2>&1; then
+    echo 'FAIL: unexpectedly permitted motor power build' >&2; exit 1
+  fi
+  grep -q 'v0.9.3: motor power blocked' "$TMP/reject.log"
+  echo "PASS: motor-power compile rejection $flags"
+done
+if [ "$(stat -c %s build/DeltaESC_G30D_v0_9_4_ble_syncsafe.bin)" -ge 53248 ]; then
+  echo 'FAIL: exceeds G30 active application region' >&2; exit 1
+fi
+if command -v llvm-nm >/dev/null 2>&1; then
+  llvm-nm build/DeltaESC_G30D_v0_9_4_ble_syncsafe.elf | grep -q 'motor_id_accept'
+  llvm-nm build/DeltaESC_G30D_v0_9_4_ble_syncsafe.elf | grep -q 'motor_id_commit'
+fi
+if ! grep -q 'case 0xF7u:' src/main.c; then
+  echo 'FAIL: Motor ID read-only status missing' >&2; exit 1
+fi
+echo 'PASS: source-only software checks (not a hardware/flash release)' 